# Copy this to .env for local development
# Never commit .env to GitHub — it's in .gitignore

# Microsoft Graph / SharePoint
MS_TENANT_ID=your-tenant-id-here
MS_CLIENT_ID=your-client-id-here
MS_CLIENT_SECRET=your-client-secret-here

# Shopify B2B
SHOPIFY_B2B_TOKEN=your-b2b-admin-token
SHOPIFY_B2B_STORE=lifelines-b2b.myshopify.com

# Shopify DTC
SHOPIFY_DTC_TOKEN=your-dtc-admin-token
SHOPIFY_DTC_STORE=lifelines-dtc.myshopify.com
